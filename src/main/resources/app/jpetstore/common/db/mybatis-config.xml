<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>

    <settings>
        <!-- http://www.mybatis.org/mybatis-3/configuration.html -->
        <!--
            Granular Caching Strategy for Multi-Node Clustered Environment:
            1) cacheEnabled=true & localCacheScope=SESSION: Enables selective L2 caching for high-traffic,
               read-heavy catalog data (CategoryMapper, ProductMapper, ItemMapper) to maximize TPS during
               performance benchmark tests.
            2) Transaction-sensitive and sequence mappers (OrderMapper, SequenceMapper, AccountMapper) do not
               declare <cache />, ensuring zero cache inconsistency or PK conflicts across cluster nodes.
        -->
        <setting name="cacheEnabled" value="true"/>
        <setting name="localCacheScope" value="SESSION"/>
        <setting name="lazyLoadingEnabled" value="false"/>
        <setting name="useColumnLabel" value="true"/>
        <setting name="useGeneratedKeys" value="false"/>
        <setting name="defaultExecutorType" value="SIMPLE"/>
        <setting name="defaultStatementTimeout" value="25000"/>
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <setting name="jdbcTypeForNull" value="VARCHAR"/>
    </settings>

    <environments default="default">
        <environment id="default">
            <transactionManager type="JDBC"/>
            <dataSource type="POOLED">
                <property name="driver" value="${driver}"/>
                <property name="url" value="${url}"/>
                <property name="username" value="${username}"/>
                <property name="password" value="${password}"/>
            </dataSource>
        </environment>
    </environments>

    <mappers>
        <package name="app/jpetstore/common/db/mapper"/>
    </mappers>

</configuration>
